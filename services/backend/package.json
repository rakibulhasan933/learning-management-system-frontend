{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src tsup.config.ts",
    "format": "prettier --write \"{src/**/*.ts,tsup.config.ts}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:studio": "pnpm --filter @workspace/db db:studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@workspace/db": "workspace:*",
    "@workspace/types": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "nodemailer": "^7.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@workspace/config": "workspace:*",
    "eslint": "^9",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
