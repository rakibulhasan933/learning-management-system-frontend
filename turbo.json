{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CORS_ORIGIN",
    "DATABASE_URL",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_OAUTH_REDIRECT_URI",
    "GMAIL_SMTP_APP_PASSWORD",
    "GMAIL_SMTP_USER",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "MANUAL_PAYMENT_BANK_DETAILS",
    "MANUAL_PAYMENT_BKASH_NUMBER",
    "MANUAL_PAYMENT_COUPONS",
    "MANUAL_PAYMENT_NAGAD_NUMBER",
    "MANUAL_PAYMENT_ROCKET_NUMBER",
    "NODE_ENV",
    "NEXT_PUBLIC_BACKEND_API_URL",
    "PORT",
    "UPLOADTHING_TOKEN",
    "R2_ACCESS_KEY_ID",
    "R2_ACCOUNT_ID",
    "R2_BUCKET_NAME",
    "R2_SECRET_ACCESS_KEY",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_NAME",
    "SEED_ADMIN_PASSWORD",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_COURSE_THUMBNAILS_BUCKET",
    "SUPABASE_STORAGE_CERTIFICATES_BUCKET",
    "SUPABASE_STORAGE_LECTURE_MATERIALS_BUCKET",
    "SUPABASE_STORAGE_PAYMENT_PROOFS_BUCKET",
    "SUPABASE_STORAGE_PROFILE_AVATARS_BUCKET",
    "SUPABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
