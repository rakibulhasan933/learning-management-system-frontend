# Web application
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
# UploadThing dashboard -> API Keys -> V7 token. Used by apps/web image uploads.
UPLOADTHING_TOKEN=

# Backend service
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
DATABASE_URL=
# Supabase Storage only. Supabase Auth is not used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Cloudflare R2. Video storage integration is intentionally not implemented yet.
R2_ACCOUNT_ID=
PAYCONFIRM_API_KEY=
PAYCONFIRM_API_URL=https://pay-confim.vercel.app/api/v1/verify
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
